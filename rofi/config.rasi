configuration {
    modi: "run,drun,window";
    icon-theme: "breeze-dark";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Search ";
    display-run: "   Run ";
    display-window: "   Window ";
    sidebar-mode: true;
}

@theme "/dev/null"

* {
    /* Background with transparency */
    bg-col:  rgba(30, 30, 46, 0.5);
    bg-selected: rgba(137, 180, 250, 0.5);
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-selected: #ffffff;

    background-color: transparent;
    text-color: @fg-col;
    margin: 0;
    padding: 0;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    height: 450px;
    width: 400px;
    background-color: @bg-col;
    border: 2px;
    border-color: @blue;
    border-radius: 15px;
}

mainbox {
    children: [inputbar, listview];
}

inputbar {
    children: [prompt, entry];
    background-color: transparent;
    padding: 20px;
}

prompt {
    background-color: @blue;
    padding: 8px 15px;
    text-color: #11111b;
    border-radius: 8px;
}

entry {
    padding: 8px;
    margin: 0 0 0 10px;
    text-color: @fg-col;
}

listview {
    border: 0px;
    padding: 10px;
    columns: 1;
    lines: 8;
    fixed-height: false;
}

element {
    padding: 10px;
    spacing: 10px;
    border-radius: 10px;
}

element selected {
    background-color: @bg-selected;
    text-color: @fg-selected;
}

element-icon {
    size: 24px;
}